{
  "name": "@org/shop",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:shop"
    ],
    "targets": {
      "serve": {
        "dependsOn": [
          "@org/api:serve"
        ]
      },
      "dev": {
        "dependsOn": [
          "@org/api:serve"
        ]
      },
      "preview": {
        "dependsOn": [
          "build",
          "@org/api:serve"
        ]
      },
      "print-secrets": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "commands": [
            "echo \"[$NX_TASK_TARGET_PROJECT] SUPER_SECRET_ENV=$SUPER_SECRET_ENV\"",
            "echo \"[$NX_TASK_TARGET_PROJECT] EVEN_MORE_SUPER_SECRET_ENV=$EVEN_MORE_SUPER_SECRET_ENV\""
          ],
          "parallel": false
        }
      }
    }
  },
  "devDependencies": {
    "@org/models": "*",
    "@org/shop-data": "*",
    "@org/shop-feature-product-detail": "*",
    "@org/shop-feature-products": "*",
    "@org/shop-shared-ui": "*"
  }
}
